# ==============================================
# Credentials for LLM, Embeddings, RAG, and Telegram Bot
# Copia este archivo como .env y configura los valores
# ==============================================

# ===== LLM - Qwen from Hugging Face (endpoint compatible con OpenAI) =====
HF_API_KEY=tu-api-key-aqui
HF_BASE_URL=https://router.huggingface.co/v1

# Modelo a usar
LLM_MODEL=Qwen/Qwen3.5-9B

# Temperatura del modelo (0.1-0.3 recomendado para RAG, según Sesión 7)
LLM_TEMPERATURE=0.1

# ===== EMBEDDINGS =====
# Proveedor de embeddings:
#   openai               = API text-embedding-3 (endpoint de OpenAI)
#   sentence-transformers = modelo local y gratuito

OPENAI_API_KEY=tu-api-key-aqui
EMBEDDING_PROVIDER=openai

# Modelo de embeddings de OpenAI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dimensiones del vector de text-embedding-3 (verificado: 1536)
OPENAI_EMBEDDING_DIM=1536

# Modelo de Sentence Transformers (solo si EMBEDDING_PROVIDER=sentence-transformers)
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ===== RAG =====
# Tamaño de chunks para división de documentos
CHUNK_SIZE=500

# Solapamiento entre chunks
CHUNK_OVERLAP=50

# Número de documentos a recuperar en búsquedas
RAG_TOP_K=10

# Umbral mínimo de similitud (0.0 - 1.0)
RAG_SCORE_THRESHOLD=0.5

# ===== FAQ =====
# Umbral mínimo de similitud coseno (0.0 - 1.0) contra el banco de
# preguntas frecuentes (faq_service.py). Si el mejor match lo supera,
# se responde directo con la FAQ en vez de usar RAG/LLM.
FAQ_SCORE_THRESHOLD=0.5

# ===== SERVIDOR =====
# Host del servidor (0.0.0.0 = accesible desde cualquier IP)
SERVER_HOST=0.0.0.0

# Puerto del servidor
SERVER_PORT=8000

# ===== MEMORIA =====
# Número de mensajes a mantener en memoria por usuario
MEMORY_K_MESSAGES=8

# ===== BOT TELEGRAM =====
TOKEN_TELEGRAM_BOT=tu-token-aqui
URL_TELEGRAM_BOT=t.me/TuBotNombre

# URL de la API para el bot (por defecto usa localhost)
API_URL=http://localhost:8000
